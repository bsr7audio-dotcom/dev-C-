#include <stdio.h>
#include <string.h>

#define MAKS_TUGAS 50
#define MAKS_TEKS 100

// Struktur untuk menyimpan data tugas sekolah
struct Tugas {
    char mataPelajaran[MAKS_TEKS];
    char deskripsi[MAKS_TEKS];
    char deadline[MAKS_TEKS];
    int status; // 0 = Belum Selesai, 1 = Selesai
};

int main() {
    struct Tugas daftarTugas[MAKS_TUGAS];
    int jumlahTugas = 0;
    int pilihan;

    while(1) {
        // Tampilan Menu Utama Utama
        printf("\n=====================================\n");
        printf("   APLIKASI MANAJEMEN TUGAS SEKOLAH  \n");
        printf("=====================================\n");
        printf("1. Tambah Tugas Baru\n");
        printf("2. Lihat Daftar Tugas\n");
        printf("3. Tandai Tugas Selesai\n");
        printf("4. Keluar\n");
        printf("Pilih menu (1-4): ");
        scanf("%d", &pilihan);
        getchar(); // Membersihkan sisa enter di memori

        if (pilihan == 1) {
            // MENAMBAH TUGAS
            if (jumlahTugas < MAKS_TUGAS) {
                printf("\n--- Tambah Tugas Baru ---\n");
                
                printf("Mata Pelajaran: ");
                fgets(daftarTugas[jumlahTugas].mataPelajaran, MAKS_TEKS, stdin);
                daftarTugas[jumlahTugas].mataPelajaran[strcspn(daftarTugas[jumlahTugas].mataPelajaran, "\n")] = 0; // Hapus enter
                
                printf("Deskripsi Tugas / PR: ");
                fgets(daftarTugas[jumlahTugas].deskripsi, MAKS_TEKS, stdin);
                daftarTugas[jumlahTugas].deskripsi[strcspn(daftarTugas[jumlahTugas].deskripsi, "\n")] = 0;
                
                printf("Tenggat Waktu (Deadline): ");
                fgets(daftarTugas[jumlahTugas].deadline, MAKS_TEKS, stdin);
                daftarTugas[jumlahTugas].deadline[strcspn(daftarTugas[jumlahTugas].deadline, "\n")] = 0;
                
                daftarTugas[jumlahTugas].status = 0; // Set awal: Belum Selesai
                jumlahTugas++;
                
                printf("\n✅ Tugas berhasil ditambahkan!\n");
            } else {
                printf("\n❌ Memori penuh! Selesaikan tugas yang ada dulu.\n");
            }
            
        } else if (pilihan == 2) {
            // MENAMPILKAN TUGAS
            printf("\n--- Daftar Tugas Sekolah ---\n");
            if (jumlahTugas == 0) {
                printf("Hore! Belum ada tugas atau PR yang dicatat.\n");
            } else {
                for (int i = 0; i < jumlahTugas; i++) {
                    printf("%d. [%s] %s\n", i + 1, 
                           daftarTugas[i].status == 1 ? "SELESAI" : "BELUM ", 
                           daftarTugas[i].mataPelajaran);
                    printf("   Detail  : %s\n", daftarTugas[i].deskripsi);
                    printf("   Deadline: %s\n", daftarTugas[i].deadline);
                    printf("   ---------------------------------\n");
                }
            }
            
        } else if (pilihan == 3) {
            // MENANDAI TUGAS SELESAI
            printf("\n--- Tandai Tugas Selesai ---\n");
            if (jumlahTugas == 0) {
                printf("Tidak ada tugas untuk diselesaikan.\n");
            } else {
                int nomorTugas;
                printf("Masukkan nomor tugas yang sudah selesai: ");
                scanf("%d", &nomorTugas);
                
                // Validasi input nomor tugas
                if (nomorTugas > 0 && nomorTugas <= jumlahTugas) {
                    daftarTugas[nomorTugas - 1].status = 1; // Ubah status jadi selesai
                    printf("\n🎉 Mantap! Tugas '%s' ditandai selesai.\n", daftarTugas[nomorTugas - 1].mataPelajaran);
                } else {
                    printf("\n❌ Nomor tugas tidak valid!\n");
                }
            }
            
        } else if (pilihan == 4) {
            // KELUAR APLIKASI
            printf("\nTerima kasih sudah menggunakan aplikasi ini. Semangat belajar!\n");
            break;
        } else {
            printf("\n❌ Pilihan tidak ada. Silakan masukkan angka 1 sampai 4.\n");
        }
    }

    return 0;
}
